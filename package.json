{
  "name": "ride-stream",
  "version": "0.1.0",
  "description": "Real-time ride-sharing GPS pipeline on Apache Kafka, NestJS, ksqlDB, and Redis",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iikareem/ride-stream.git"
  },
  "bugs": {
    "url": "https://github.com/iikareem/ride-stream/issues"
  },
  "homepage": "https://github.com/iikareem/ride-stream#readme",
  "keywords": [
    "kafka",
    "nestjs",
    "avro",
    "schema-registry",
    "ksqldb",
    "redis",
    "websocket",
    "stream-processing"
  ],
  "scripts": {
    "build": "nest build",
    "start": "nest start --entryFile drivers/producer/main",
    "start:dev": "nest start --watch --entryFile drivers/producer/main",
    "start:producer": "nest start --entryFile drivers/producer/main",
    "start:producer:dev": "nest start --watch --entryFile drivers/producer/main",
    "start:rider-producer": "nest start --entryFile riders/producer/main",
    "start:rider-producer:dev": "nest start --watch --entryFile riders/producer/main",
    "start:rider-geo": "nest start --entryFile riders/consumer/geo/main",
    "start:rider-geo:dev": "nest start --watch --entryFile riders/consumer/geo/main",
    "start:gateway": "nest start --entryFile gateway/main",
    "start:gateway:dev": "nest start --watch --entryFile gateway/main",
    "start:nearby": "nest start --entryFile drivers/consumer/nearby/main",
    "start:nearby:dev": "nest start --watch --entryFile drivers/consumer/nearby/main",
    "start:eta": "nest start --entryFile drivers/consumer/eta/main",
    "start:eta:dev": "nest start --watch --entryFile drivers/consumer/eta/main",
    "emit:test": "node scripts/emit-test.js"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.2.3",
    "@nestjs/websockets": "^11.2.3",
    "ioredis": "^6.0.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
