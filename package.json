{
  "name": "ride-stream",
  "version": "0.1.0",
  "description": "Real-time ride-sharing GPS pipeline on Apache Kafka (NestJS)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:producer": "nest start --entryFile producer/main",
    "start:producer:dev": "nest start --watch --entryFile producer/main",
    "start:consumer": "nest start --entryFile consumer/main",
    "start:consumer:dev": "nest start --watch --entryFile consumer/main",
    "start:eta": "nest start --entryFile eta/main",
    "start:eta:dev": "nest start --watch --entryFile eta/main",
    "start:live-map": "nest start --entryFile live-map/main",
    "start:live-map:dev": "nest start --watch --entryFile live-map/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest"
  },
  "dependencies": {
    "@kafkajs/confluent-schema-registry": "^4.1.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
